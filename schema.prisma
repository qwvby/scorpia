// Scorpia B2B Work Platform — database schema.
// One source of truth: Task/Project are the canonical records; every view
// (Dashboard, Calendar, Gantt, My Tasks) reads from these same tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeadlineMode {
  DYNAMIC
  LOCKED
}

enum ProjectProgressMode {
  TASKS
  EFFORT
  MANUAL
}

enum TaskProgressMode {
  AUTO
  MANUAL
}

enum DependencyType {
  FS // Finish-to-Start
  SS // Start-to-Start
  FF // Finish-to-Finish
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  color        String   @default("#8FCB2E")
  createdAt    DateTime @default(now())

  ownedProjects   Project[]      @relation("ProjectOwner")
  memberships     ProjectMember[]
  responsibleFor  Task[]         @relation("TaskResponsible")
  comments        Comment[]
  notifications   Notification[]
  activities      Activity[]
}

model Project {
  id            String              @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus       @default(PLANNING)
  startDate     DateTime
  deadline      DateTime
  deadlineMode  DeadlineMode        @default(DYNAMIC)
  progressMode  ProjectProgressMode @default(TASKS)
  progress      Int                 @default(0)
  ownerId       String
  owner         User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  tasks         Task[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  @@unique([projectId, userId])
}

model Task {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTaskId   String?
  parent         Task?             @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]            @relation("Subtasks")
  title          String
  description    String?
  status         TaskStatus        @default(TODO)
  priority       Priority          @default(MEDIUM)
  progress       Int               @default(0)
  progressMode   TaskProgressMode  @default(MANUAL)
  estimatedHours Float             @default(0)
  actualMinutes  Int               @default(0)
  startDate      DateTime
  dueDate        DateTime
  responsibleId  String?
  responsible    User?             @relation("TaskResponsible", fields: [responsibleId], references: [id])
  dependsOn      Dependency[]      @relation("DepTo")
  blocks         Dependency[]      @relation("DepFrom")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId])
  @@index([parentTaskId])
  @@index([responsibleId])
}

model Dependency {
  id         String         @id @default(cuid())
  fromTaskId String
  fromTask   Task           @relation("DepFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTaskId   String
  toTask     Task           @relation("DepTo", fields: [toTaskId], references: [id], onDelete: Cascade)
  type       DependencyType @default(FS)
  createdAt  DateTime       @default(now())

  @@unique([fromTaskId, toTaskId])
}

// Polymorphic comments: entityType is "task" or "project", entityId points to that record.
model Comment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
}

// Global, append-only audit trail. entityType/entityId point at the Project or Task changed.
model Activity {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  entityName String?
  action     String
  detail     String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
