# PostgreSQL connection string. Locally, e.g.:
# postgresql://postgres:postgres@localhost:5432/scorpia?schema=public
# On Railway/Render, this is provided automatically as DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scorpia?schema=public"

# Long random string used to sign JWT tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_me_with_a_long_random_string"

# How long a login session stays valid
JWT_EXPIRES_IN="7d"

# Port the API listens on
PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN="http://localhost:5173"
